# All optional. You can instead connect a provider inside Doodle, which offers
# to remember the key on this computer.

# Google Gemini has a free tier. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# OpenAI. Key: https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=your_key_here

# Recraft. Token: https://app.recraft.ai/profile/api
RECRAFT_API_TOKEN=your_token_here

# Optional. Defaults to ~/.doodle
# DOODLE_DATA_DIR=/path/to/local/data
